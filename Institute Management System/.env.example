# ---------------------------------------------------------------------------
# Institute Management System environment template. Copy to `.env` and change every secret.
# ---------------------------------------------------------------------------

# Compose project / public entry point
COMPOSE_PROJECT_NAME=sourcepoint-institute
HTTP_PORT=8080
# Public URL users type in the browser (used in reset links and payment callbacks)
PUBLIC_BASE_URL=http://localhost:8080

# Application
APP_ENV=development
APP_NAME=Institute Management System
LOG_LEVEL=INFO
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key used to encrypt integration secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key
SOURCEPOINT_SSO_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
MAX_UPLOAD_MB=25
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# PostgreSQL
POSTGRES_DB=classflow
POSTGRES_USER=classflow
POSTGRES_PASSWORD=change-me-postgres-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=classflow-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=classflow
S3_REGION=us-east-1
# Leave S3_ENDPOINT empty to use the bundled MinIO (http://minio:9000)
S3_ENDPOINT=

# Backups
BACKUP_RETENTION_DAYS=14
# Passphrase used for AES-256 encryption of backup archives (required for prod backups)
BACKUP_ENCRYPTION_PASSPHRASE=change-me-backup-passphrase
BACKUP_SCHEDULE_HOUR=2

# Frontend
NEXT_PUBLIC_APP_NAME=Institute Management System

# ---------------------------------------------------------------------------
# Optional platform-level fallbacks for integrations. Per-institute settings
# configured in the UI (Settings -> Integrations) take precedence.
# All external channels are DISABLED until credentials are configured.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
