# Optional CoinBack Finder configuration for the SourcePoint deployment.
# Add selected values to SourcePoint's root .env or copy this file to
# coinback-finder/.env (ignored by Git). SourcePoint injects the shared database
# URL and COINBACK_SSO_SECRET; do not add a separate database or login secret.

APP_ENV=production
LOG_LEVEL=INFO

DISPLAY_TIMEZONE=Asia/Kolkata
CURRENCY=INR

FLIPKART_ALLOWED_HOSTS=www.flipkart.com,flipkart.com,dl.flipkart.com
THIRD_PARTY_ALLOWED_HOSTS=
HTTP_TIMEOUT_SECONDS=15
HTTP_USER_AGENT=CoinBackFinder/1.0 (private price monitor)

SCANNER_ENABLED=true
DEFAULT_SCAN_INTERVAL_MINUTES=15
PRODUCT_PAGE_FETCH_ENABLED=false
PRODUCT_PAGE_PERMISSION_CONFIRMED=false

GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
BRAVE_SEARCH_API_KEY=
THIRD_PARTY_FEED_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=true
TELEGRAM_COMMANDS_ENABLED=false
